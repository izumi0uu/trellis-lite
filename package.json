{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter trellis-lite-core build && pnpm --filter trellis-lite build",
    "build:core": "pnpm --filter trellis-lite-core build",
    "build:cli": "pnpm --filter trellis-lite build",
    "test": "pnpm --filter trellis-lite-core test && pnpm --filter trellis-lite test",
    "test:core": "pnpm --filter trellis-lite-core test",
    "test:cli": "pnpm --filter trellis-lite test",
    "lint": "pnpm --filter trellis-lite-core lint && pnpm --filter trellis-lite lint",
    "typecheck": "pnpm --filter trellis-lite-core build && pnpm --filter trellis-lite typecheck",
    "release": "pnpm --filter trellis-lite release",
    "release:minor": "pnpm --filter trellis-lite release:minor",
    "release:major": "pnpm --filter trellis-lite release:major",
    "release:beta": "pnpm --filter trellis-lite release:beta",
    "release:rc": "pnpm --filter trellis-lite release:rc",
    "release:promote": "pnpm --filter trellis-lite release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
